# ============================================================
# ArchiGen AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to version control.
# ============================================================

# --- Supabase (required) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AI / Image Generation ---
# Provide at least ONE of the keys below.
# Priority: GEMINI_API_KEY > AI_API_KEY (OpenRouter) > Flux (public, no key needed)

# Google Gemini API key — enables Imagen 3, Gemini Flash Image, and Vision analysis
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# OpenRouter API key — enables any OpenRouter model as fallback
AI_API_KEY=sk-or-v1-your_openrouter_key_here

# (Optional) Override the base URL for custom OpenAI-compatible endpoints
AI_BASE_URL=https://openrouter.ai/api/v1

# (Optional) Override which models to use
AI_IMAGE_MODEL=imagen-3.0-generate-002
AI_TEXT_MODEL=gemini-3.5-flash

# --- Payments (optional — omit for test/sandbox mode) ---
# When omitted, the checkout runs in simulated test mode (no real charges).
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
